# Leave empty to run the Console on demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# This deployment's own origin (metadata, absolute links); defaults to https://lorde-console.vercel.app.
NEXT_PUBLIC_SITE_URL=
# Gateway used by the playground, uploads and jobs (server side only).
LORDE_GATEWAY_URL=
# Single-tenant self-hosting only: ignored whenever Supabase is configured.
LORDE_API_KEY=
# Same pepper as the Gateway: the Console hashes new API keys before inserting them under RLS.
LORDE_KEY_PEPPER=
# Public Gateway URL shown in docs, and used to resolve relative upload URLs from the Gateway.
NEXT_PUBLIC_LORDE_API_URL=
NEXT_PUBLIC_HF_ARTICLE_URL=
