# Leave empty to run the Console on demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# This deployment's own origin (metadata, absolute links); defaults to https://lorde-console.vercel.app.
NEXT_PUBLIC_SITE_URL=
# Gateway used by the playground, uploads and jobs (server side only).
LORDE_GATEWAY_URL=
# Single-tenant self-hosting only: ignored whenever Supabase is configured.
LORDE_API_KEY=
# Same pepper as the Gateway: the Console hashes new API keys before inserting them under RLS.
LORDE_KEY_PEPPER=
# Public Gateway URL shown in docs, and used to resolve relative upload URLs from the Gateway.
NEXT_PUBLIC_LORDE_API_URL=
# Optional: the model revision the Gateway serves (e.g. lorde-tiny-aya@v1.0.0), shown on /status; a revision
# containing "base" (staging-base-cpu) is flagged as the untrained base model.
NEXT_PUBLIC_LORDE_MODEL_REVISION=
# Optional, server side only: the same value as the Gateway's LORDE_RELAY_SECRET, so the /api/gateway relay can pass
# each user's IP and the Gateway's per-IP limit applies per user instead of to the Console's servers.
LORDE_RELAY_SECRET=
# Optional: Cloudflare Turnstile site key (public). Set it only together with Supabase Auth -> Bot and Abuse
# Protection -> Turnstile and the matching secret key (docs/DEPLOYMENT.md); empty = no CAPTCHA on the auth forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
