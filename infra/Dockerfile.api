# Lorde API (staging): Gateway + Job Worker in one container, sharing a volume for dataset storage.
#   docker build -f infra/Dockerfile.api -t lorde-api .
FROM python:3.15-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
# Exact versions with sha256 hashes (audit 2, S11): requirements/runtime.lock, generated from image.in
COPY requirements/runtime.lock requirements/runtime.lock
RUN pip install --require-hashes --no-deps -r requirements/runtime.lock
COPY lorde_forge/ lorde_forge/
COPY gateway/ gateway/
COPY worker/ worker/
COPY supabase/ supabase/
COPY infra/start-api.sh /usr/local/bin/start-api
RUN chmod 755 /usr/local/bin/start-api && useradd --create-home --uid 10001 lorde
ENV LORDE_STORAGE_DIR=/data/storage LORDE_WORK_DIR=/data/work PORT=8080
EXPOSE 8080
CMD ["start-api"]
