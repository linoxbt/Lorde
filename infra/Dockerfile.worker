# Lorde Job Worker: docker build -f infra/Dockerfile.worker -t lorde-worker .
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements/runtime.txt requirements/runtime.txt
RUN pip install -r requirements/runtime.txt "curatorkit[generation]==0.1.23" pyarrow
COPY lorde_forge/ lorde_forge/
COPY gateway/ gateway/
COPY worker/ worker/
RUN useradd --create-home --uid 10001 lorde && mkdir -p /work && chown lorde /work
USER lorde
ENV LORDE_WORK_DIR=/work
CMD ["python", "-m", "worker.main"]
