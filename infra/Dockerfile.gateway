# Lorde Gateway: docker build -f infra/Dockerfile.gateway -t lorde-gateway .
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements/runtime.txt requirements/runtime.txt
RUN pip install -r requirements/runtime.txt
COPY lorde_forge/ lorde_forge/
COPY gateway/ gateway/
RUN useradd --create-home --uid 10001 lorde && mkdir -p /data && chown lorde /data
USER lorde
ENV LORDE_KEYS_FILE=/data/keys.json LORDE_USAGE_FILE=/data/usage.jsonl PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request,os;urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"PORT\"]}/healthz')"
CMD ["sh", "-c", "uvicorn gateway.app:app --host 0.0.0.0 --port ${PORT} --proxy-headers --workers 1"]
